# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myapp
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h

# Bcrypt Configuration
BCRYPT_COST=10

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Redis Cache Configuration (Optional)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST=200

# Tracing Configuration (Optional)
TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:14268/api/traces
TRACING_SERVICE_NAME=go-hex-api

# Metrics Configuration
METRICS_ENABLED=true
# Webhook Configuration
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5s
WEBHOOK_MAX_RETRY_DELAY=60s

# WhatsApp Configuration
WHATSAPP_ENABLED=true
WHATSAPP_QR_TIMEOUT=60s
WHATSAPP_RECONNECT_INTERVAL=30s
WHATSAPP_MAX_RECONNECT_ATTEMPTS=5
WHATSAPP_MESSAGE_RETENTION_DAYS=90
WHATSAPP_MEDIA_MAX_SIZE_MB=16
WHATSAPP_MEDIA_STORAGE_PATH=./data/whatsapp/media
WHATSAPP_WEBHOOK_TIMEOUT=10s
WHATSAPP_WEBHOOK_MAX_RETRIES=3
WHATSAPP_WEBHOOK_RETRY_DELAY=5s
